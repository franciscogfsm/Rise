# Copy to .env (scripts/setup.sh does it and generates the local Garage keys). Never commit .env.

# --- AI (OpenRouter) --- the key stays on the server, never in the browser
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# --- access --- set a password before exposing RISE beyond localhost (HTTP basic auth, any user name)
RISE_PASSWORD=
# RISE_BIND=0.0.0.0 publishes the port (Docker); only with RISE_PASSWORD set
RISE_BIND=127.0.0.1

# --- the application under test ---
# asset-service shipped with one region setting reused for every S3 client
APP_REGION=us-east-1

# --- Source provider (simulated: moto) ---
SOURCE_NAME="moto S3 · local"
SOURCE_ENDPOINT=http://127.0.0.1:9001
SOURCE_REGION=us-east-1
SOURCE_BUCKET=rise-assets
SOURCE_TEST_BUCKET=rise-test
SOURCE_ACCESS_KEY=rise-local
SOURCE_SECRET_KEY=rise-local-secret
SOURCE_SIMULATED=1
SOURCE_LINK_PORT=9101

# --- Destination provider (simulated: Garage) --- keys generated by scripts/setup.sh
DEST_NAME="Garage S3 · local"
DEST_ENDPOINT=http://127.0.0.1:3900
DEST_REGION=nl-ams-1
DEST_BUCKET=rise-assets
DEST_TEST_BUCKET=rise-test
DEST_ACCESS_KEY=
DEST_SECRET_KEY=
DEST_SIMULATED=1
GARAGE_RPC_SECRET=

# --- Real providers (optional) ---
# Easiest: add them in the UI (/connect), keys encrypted at rest. Or point SOURCE_*/DEST_* here at
# dedicated test buckets, set *_SIMULATED=0, and use least-privilege keys. Never production buckets.
